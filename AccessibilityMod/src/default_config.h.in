/*
 * default_config.h.in -- template for the generated default_config.h.
 *
 * CMake embeds the canonical AccessibilityMod/ffvii_accessibility.cfg into
 * the DLL as a byte array at CONFIGURE time (file(READ ... HEX) in
 * CMakeLists.txt), so the default file Config::Load() creates when the cfg
 * is missing is ALWAYS byte-identical in content to the repo's canonical
 * file — there is no second copy of the text to drift out of sync (the
 * "comment-only documentation goes stale in the same commit" lesson,
 * applied to config).
 *
 * A byte array is used instead of a raw string literal deliberately: MSVC
 * caps a single string literal at ~16K (C2026) and the config file sits
 * near that size; a byte array has no such limit and also sidesteps every
 * escaping concern.
 *
 * The cfg file is registered in CMAKE_CONFIGURE_DEPENDS, so editing it
 * triggers a CMake re-configure (and thus a fresh header) on the next
 * build — do NOT edit the generated default_config.h by hand.
 */
#pragma once

#include <cstddef>

namespace Config {

// The canonical ffvii_accessibility.cfg, byte for byte as committed.
// Line endings are normalized at WRITE time (config.cpp strips '\r' and
// writes in text mode so Windows users always get CRLF regardless of how
// git checked the source file out).
inline constexpr unsigned char kDefaultConfigBytes[] = { @DEFAULT_CFG_BYTES@ };
inline constexpr size_t kDefaultConfigSize = sizeof(kDefaultConfigBytes);

} // namespace Config
